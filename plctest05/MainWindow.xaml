<Window x:Class="plctest05.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLC MES Monitor"
        Height="800" Width="900">

    <ScrollViewer>
        <StackPanel Margin="10">

            <Button Content="PLC Connect" Click="Connect_Click" Height="40"/>

            <TextBlock x:Name="txtOutput"
                       FontFamily="Consolas"
                       FontSize="14"
                       Margin="0,10"/>

        </StackPanel>
    </ScrollViewer>

</Window>