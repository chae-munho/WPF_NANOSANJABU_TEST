<Window x:Class="plctest05.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLC MES Monitor"
        Height="800" Width="1200">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 버튼 -->
        <Button Grid.Row="0"
                Content="PLC Connect"
                Click="Connect_Click"
                Height="40"
                Margin="0,0,0,10"/>

        <!-- 좌우 분할 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽 기존 데이터 -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="txtLeftOutput"
                               FontFamily="Consolas"
                               FontSize="14"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <!-- 오른쪽 새 데이터 + 제어 UI -->
            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 우측 상단 제어 영역 -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <TextBlock Text="D0 :"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   FontWeight="Bold"/>

                        <ComboBox x:Name="cmbD0Error"
                                  Width="320"
                                  Height="35"
                                  Margin="0,0,8,0"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="6"/>
                            <ComboBoxItem Content="7"/>
                            <ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="9"/>
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="11"/>
                            <ComboBoxItem Content="12"/>
                            <ComboBoxItem Content="13"/>
                            <ComboBoxItem Content="14"/>
                            <ComboBoxItem Content="15"/>
                        </ComboBox>

                        <Button Content="D0 Write"
                                Width="90"
                                Height="35"
                                Margin="0,0,8,0"
                                Click="D0Write_Click"/>

                        <Button Content="M3017 ON"
                                Width="100"
                                Height="35"
                                Margin="0,0,8,0"
                                Click="M3017On_Click"/>

                        <Button Content="M3017 OFF"
                                Width="100"
                                Height="35"
                                Click="M3017Off_Click"/>
                    </StackPanel>

                    <!-- 우측 출력 -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtRightOutput"
                                   FontFamily="Consolas"
                                   FontSize="14"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>